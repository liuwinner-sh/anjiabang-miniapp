<scroll-view class="page" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
  
  <!-- 骨架屏 -->
  <view class="skeleton" wx:if="{{loading}}">
    <view class="sk-user"><view class="sk-circle"></view><view class="sk-lines"><view class="sk-line w60"></view><view class="sk-line w40"></view></view></view>
    <view class="sk-row"><view class="sk-box" wx:for="4"><view class="sk-bar w80"></view><view class="sk-bar w60"></view></view></view>
    <view class="sk-chart"><view class="sk-bar w100"></view><view class="sk-bar w100"></view><view class="sk-bar w100"></view><view class="sk-bar w80"></view><view class="sk-bar w60"></view><view class="sk-bar w80"></view></view>
  </view>
  
  <!-- 顶部用户卡片 -->
  <view class="user-card" wx:if="{{!loading}}">
    <view class="user-avatar">{{userInitial}}</view>
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-date">{{dateStr}} · {{stats.rentedCount}}/{{stats.propertyCount}}套已租</text>
    </view>
  </view>

  <!-- 关键指标 -->
  <view class="kpi-grid">
    <view class="kpi-card kpi-blue" bindtap="goProperties">
      <view class="kpi-icon"><text>🏠</text></view>
      <text class="kpi-num">{{stats.propertyCount}}</text>
      <text class="kpi-lbl">房源总数</text>
    </view>
    <view class="kpi-card kpi-green" bindtap="goTenants">
      <view class="kpi-icon"><text>👤</text></view>
      <text class="kpi-num">{{stats.rentedCount}}</text>
      <text class="kpi-lbl">已出租</text>
    </view>
    <view class="kpi-card kpi-orange" bindtap="goProperties">
      <view class="kpi-icon"><text>🔑</text></view>
      <text class="kpi-num">{{stats.vacantCount}}</text>
      <text class="kpi-lbl">空置中</text>
    </view>
    <view class="kpi-card kpi-red" bindtap="goBills">
      <view class="kpi-icon"><text>💰</text></view>
      <text class="kpi-num">¥{{stats.monthlyIncome}}</text>
      <text class="kpi-lbl">月租金</text>
    </view>
  </view>

  <!-- 收款率 -->
  <view class="card">
    <view class="card-hd"><text class="card-title">📊 本月收款</text></view>
    <view class="rate-bar-wrap">
      <view class="rate-bar">
        <view class="rate-fill" style="width:{{stats.collectionRate}}%"></view>
      </view>
      <text class="rate-num">{{stats.collectionRate}}%</text>
    </view>
    <text class="rate-detail">{{stats.paidCount}}/{{stats.totalBills}}笔已收</text>
  </view>

  <!-- 🚀 推广中心 -->
  <view class="card promo-card" wx:if="{{!loading}}">
    <view class="card-hd">
      <text class="card-title">🚀 推广中心</text>
      <text class="card-more">让房源更快出租 ›</text>
    </view>
    <view class="promo-grid">
      <view class="promo-item" bindtap="showPropPicker" data-action="pricing">
        <view class="promo-icon-wrap promo-icon-price"><text class="pi-emoji">💰</text></view>
        <text class="pi-title">AI智能定价</text>
        <text class="pi-desc">同小区比价·合理建议</text>
      </view>
      <view class="promo-item" bindtap="showPropPicker" data-action="poster">
        <view class="promo-icon-wrap promo-icon-poster"><text class="pi-emoji">🖼️</text></view>
        <text class="pi-title">招租海报</text>
        <text class="pi-desc">一键生成·分享朋友圈</text>
      </view>
      <view class="promo-item" bindtap="showPropPicker" data-action="distribute">
        <view class="promo-icon-wrap promo-icon-dist"><text class="pi-emoji">📤</text></view>
        <text class="pi-title">多平台分发</text>
        <text class="pi-desc">6渠道文案·一键复制</text>
      </view>
      <view class="promo-item" bindtap="showPropPicker" data-action="desc">
        <view class="promo-icon-wrap promo-icon-desc"><text class="pi-emoji">✨</text></view>
        <text class="pi-title">AI房源描述</text>
        <text class="pi-desc">卖点提炼·自动生成</text>
      </view>
    </view>
    <view class="promo-tip" wx:if="{{promoTip}}">
      <text class="pt-icon">💡</text>
      <text class="pt-text">{{promoTip}}</text>
    </view>
  </view>

  <!-- 房源选择弹窗 -->
  <view class="modal-mask" wx:if="{{showPropPicker}}" bindtap="hidePropPicker"></view>
  <view class="modal prop-picker" wx:if="{{showPropPicker}}">
    <view class="modal-hd">
      <text class="modal-title">{{pickerTitle}}</text>
      <text class="modal-close" bindtap="hidePropPicker">✕</text>
    </view>
    <scroll-view class="modal-list" scroll-y>
      <view class="prop-option" wx:for="{{allProps}}" wx:key="id" bindtap="pickProperty" data-id="{{item.id}}" data-action="{{pickerAction}}">
        <view class="po-avatar"><text>🏠</text></view>
        <view class="po-body">
          <text class="po-name">{{item.name || item.title}}</text>
          <text class="po-spec">{{item.room||'?'}}室{{item.hall||'?'}}厅 · ¥{{item.price||0}}/月</text>
        </view>
        <text class="po-arrow">›</text>
      </view>
    </scroll-view>
  </view>

  <!-- 待办提醒 -->
  <view class="card">
    <view class="card-hd">
      <text class="card-title">⏰ 待办提醒</text>
      <text class="card-more" wx:if="{{alerts.length>0}}">{{alerts.length}}项</text>
    </view>
    <view class="alert-list">
      <view class="alert-item" wx:for="{{alerts}}" wx:for-index="idx" wx:key="idx" bindtap="onAlert" data-idx="{{idx}}">
        <text class="alert-icon">{{item.icon}}</text>
        <view class="alert-body">
          <text class="alert-text">{{item.text}}</text>
          <text class="alert-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
        </view>
        <button class="alert-btn" wx:if="{{item.action}}" catchtap="onAlertBtn" data-idx="{{idx}}">处理</button>
      </view>
    </view>
    <view class="alert-empty" wx:if="{{alerts.length===0}}">
      <text>✅ 一切正常，暂无待办</text>
    </view>
  </view>

  <!-- 收入趋势 -->
  <view class="card">
    <view class="card-hd"><text class="card-title">📈 收入趋势</text></view>
    <view class="chart">
      <view class="chart-bar" wx:for="{{monthlyIncome}}" wx:key="idx">
        <view class="bar" style="height:{{item.pct}}%"><text class="bar-val">¥{{item.val}}</text></view>
        <text class="bar-lbl">{{item.monthLabel}}</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="card">
    <view class="card-hd"><text class="card-title">⚡ 快捷操作</text></view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goAddProp"><text class="qi-icon">🏠</text><text class="qi-txt">添加房源</text></view>
      <view class="quick-item" bindtap="goAddTenant"><text class="qi-icon">👤</text><text class="qi-txt">添加租客</text></view>
      <view class="quick-item" bindtap="goAddBill"><text class="qi-icon">💰</text><text class="qi-txt">记一笔</text></view>
      <view class="quick-item" bindtap="goReport"><text class="qi-icon">📊</text><text class="qi-txt">看报表</text></view>
      <view class="quick-item" bindtap="goContract"><text class="qi-icon">📝</text><text class="qi-txt">合同管理</text></view>
      <view class="quick-item" bindtap="goRepairs"><text class="qi-icon">🔧</text><text class="qi-txt">报修</text></view>
    </view>
  </view>

  <!-- 房源速览 -->
  <view class="card">
    <view class="card-hd">
      <text class="card-title">🏘️ 房源速览</text>
      <text class="card-more" bindtap="goProperties">全部 {{stats.propertyCount}}套 ›</text>
    </view>
    <view class="prop-card" wx:for="{{recentProps}}" wx:key="id" bindtap="viewProperty" data-id="{{item.id}}">
      <view class="prop-img" wx:if="{{item.photos && item.photos[0]}}">
        <image src="{{item.photos[0]}}" mode="aspectFill"/>
      </view>
      <view class="prop-img placeholder" wx:else><text>🏠</text></view>
      <view class="prop-body">
        <text class="prop-name">{{item.name || item.title}}</text>
        <text class="prop-addr">{{item.address || item.community || '地址待补充'}}</text>
        <view class="prop-meta">
          <text class="prop-rent">¥{{item.price || 0}}<text class="prop-unit">/月</text></text>
          <text class="prop-badge {{item.status}}">{{item.status==='rented'?'已租':item.status==='active'?'待租':'其他'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item on"><text class="nav-icon">🏠</text><text class="nav-txt">首页</text></view>
    <view class="nav-item" bindtap="goProperties"><text class="nav-icon">🏘️</text><text class="nav-txt">房源</text></view>
    <view class="nav-item" bindtap="goBills"><text class="nav-icon">💰</text><text class="nav-txt">账单</text></view>
    <view class="nav-item" bindtap="goReport"><text class="nav-icon">📊</text><text class="nav-txt">报表</text></view>
    <view class="nav-item" bindtap="goSettings"><text class="nav-icon">👤</text><text class="nav-txt">我的</text></view>
  </view>
</scroll-view>
