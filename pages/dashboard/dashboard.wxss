.page { padding: 30rpx 30rpx 120rpx; background: #F5F7FA; min-height: 100vh; }

/* 用户卡片 */
.user-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 30rpx; }
.user-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: linear-gradient(135deg,#2E6BFF,#6C5CE7); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; }
.user-name { font-size: 36rpx; font-weight: 700; color: #1E2A3B; display: block; }
.user-date { font-size: 24rpx; color: #6B7A8D; margin-top: 4rpx; display: block; }

/* KPI */
.kpi-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.kpi { flex: 1; border-radius: 16rpx; padding: 20rpx 12rpx; text-align: center; }
.kpi.blue { background: #E8F0FF; }
.kpi.green { background: #E1F5EE; }
.kpi.orange { background: #FAEEDA; }
.kpi.red { background: #FCEBEB; }
.kpi-num { display: block; font-size: 32rpx; font-weight: 700; }
.kpi.blue .kpi-num { color: #2E6BFF; }
.kpi.green .kpi-num { color: #0F6E56; }
.kpi.orange .kpi-num { color: #B8860B; }
.kpi.red .kpi-num { color: #C62828; }
.kpi-lbl { display: block; font-size: 22rpx; color: #6B7A8D; margin-top: 4rpx; }

/* 通用卡片 */
.section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 600; }
.section-more { font-size: 24rpx; color: #2E6BFF; }

/* 收款率 */
.collection-rate { }
.rate-bar { height: 24rpx; background: #F0F2F5; border-radius: 12rpx; overflow: hidden; }
.rate-fill { height: 100%; background: linear-gradient(90deg,#00C48C,#2E6BFF); border-radius: 12rpx; transition: width 0.5s; }
.rate-text { font-size: 22rpx; color: #6B7A8D; margin-top: 8rpx; display: block; }

/* 柱状图 */
.chart { display: flex; align-items: flex-end; gap: 12rpx; height: 200rpx; padding: 0 10rpx; }
.chart-bar { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
.bar { width: 100%; max-width: 60rpx; background: linear-gradient(180deg,#2E6BFF,#6C5CE7); border-radius: 8rpx 8rpx 0 0; position: relative; min-height: 8rpx; }
.bar-val { position: absolute; top: -36rpx; left: 50%; transform: translateX(-50%); font-size: 18rpx; color: #2E6BFF; font-weight: 500; white-space: nowrap; }
.bar-lbl { font-size: 20rpx; color: #6B7A8D; margin-top: 8rpx; }

/* 提醒 */
.alert-item { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; margin-bottom: 12rpx; border-radius: 12rpx; font-size: 24rpx; }
.alert-item[data-idx] { background: #FAEEDA; border: 2rpx solid #FAC775; }
.alert-icon { font-size: 32rpx; }
.alert-body { flex: 1; }
.alert-text { display: block; font-weight: 500; }
.alert-detail { font-size: 22rpx; opacity: 0.7; margin-top: 4rpx; display: block; }
.alert-btn { font-size: 22rpx; padding: 8rpx 20rpx; border-radius: 10rpx; border: 2rpx solid #FAC775; background: #fff; color: #633806; line-height: 1.6; }
.alert-empty { padding: 30rpx; text-align: center; color: #0F6E56; font-size: 24rpx; background: #E1F5EE; border-radius: 12rpx; }

/* 快捷 */
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-item { width: calc(33.33% - 12rpx); padding: 24rpx 0; text-align: center; background: #F8FAFB; border-radius: 12rpx; font-size: 22rpx; color: #1E2A3B; }
.qi-icon { display: block; font-size: 40rpx; margin-bottom: 8rpx; }

/* 房源卡片 */
.prop-card { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 2rpx solid #F0F2F5; }
.prop-card:last-child { border-bottom: none; }
.prop-img { width: 160rpx; height: 120rpx; border-radius: 12rpx; overflow: hidden; flex-shrink: 0; background: #F0F2F5; }
.prop-img image { width: 100%; height: 100%; }
.prop-img.placeholder { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.prop-body { flex: 1; min-width: 0; }
.prop-name { font-size: 28rpx; font-weight: 600; display: block; }
.prop-addr { font-size: 22rpx; color: #6B7A8D; margin-top: 4rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.prop-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.prop-rent { font-size: 28rpx; font-weight: 700; color: #2E6BFF; }
.prop-status { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 20rpx; }
.prop-status.rented { background: #E1F5EE; color: #0F6E56; }
.prop-status.active { background: #FAEEDA; color: #633806; }

/* 智能配盘 */
.match-card { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; border-left: 4rpx solid #2E6BFF; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.match-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.match-customer { font-size: 26rpx; font-weight: 600; }
.match-score { font-size: 20rpx; padding: 4rpx 12rpx; background: #E1F5EE; color: #0F6E56; border-radius: 16rpx; }
.match-prop { font-size: 24rpx; font-weight: 500; color: #333; display: block; }
.match-spec { font-size: 22rpx; color: #6B7A8D; display: block; margin-top: 4rpx; }
.match-reason { font-size: 22rpx; color: #2E6BFF; margin-top: 8rpx; padding: 8rpx 12rpx; background: #E8F0FF; border-radius: 8rpx; display: block; }

/* 底部导航 */
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: #fff; border-top: 2rpx solid #E4E9F0; padding-bottom: env(safe-area-inset-bottom); z-index: 100; }
.nav-item { flex: 1; padding: 12rpx 0; text-align: center; font-size: 20rpx; color: #6B7A8D; }
.nav-item text:first-child { font-size: 40rpx; display: block; margin-bottom: 4rpx; }
.nav-item.on { color: #2E6BFF; }
