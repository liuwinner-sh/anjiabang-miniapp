<scroll-view class="page" scroll-y>
  <!-- 租客合同信息 -->
  <view class="card tenant-card" wx:if="{{tenant.name}}">
    <view class="section-hd"><text class="section-title">👤 当前租客</text></view>
    <view class="t-info">
      <view class="t-row"><text class="t-lbl">姓名</text><text class="t-val">{{tenant.name}}</text></view>
      <view class="t-row"><text class="t-lbl">租金</text><text class="t-val">¥{{tenant.rent_amount}}/月（{{tenant.payment_type||'月付'}}）</text></view>
      <view class="t-row" wx:if="{{tenant.deposit}}"><text class="t-lbl">押金</text><text class="t-val">¥{{tenant.deposit}}</text></view>
      <view class="t-row" wx:if="{{tenant.move_in_date}}"><text class="t-lbl">入住</text><text class="t-val">{{tenant.move_in_date.slice(0,10)}}</text></view>
      <view class="t-row"><text class="t-lbl">合同到期</text><text class="t-val {{tenant.daysLeft<=30?'urgent':''}}">{{tenant.endDisplay || '未设置'}}</text></view>
      <view class="t-row" wx:if="{{tenant.daysLeft>0 && tenant.daysLeft<=30}}">
        <text class="t-lbl"></text>
        <text class="t-val urgent">⚠️ {{tenant.daysLeft}}天后到期，请及时处理</text>
      </view>
      <view class="t-row" wx:if="{{tenant.daysLeft<=0}}">
        <text class="t-lbl"></text>
        <text class="t-val expired">⚠️ 已到期{{Math.abs(tenant.daysLeft)}}天</text>
      </view>
    </view>
    <view class="t-actions">
      <button class="btn-renew" bindtap="renewContract">续签合同（延长1年）</button>
      <button class="btn-view-bills" bindtap="goTenantBills">查看账单</button>
    </view>
  </view>

  <!-- 房源描述/AI生成 -->
  <view class="card" wx:if="{{p.description || p.ai_tags}}">
    <view class="section-hd"><text class="section-title">📝 房源描述</text></view>
    <text class="desc-text" wx:if="{{p.description}}">{{p.description}}</text>
    <view class="tag-row" wx:if="{{p.ai_tags}}">
      <text class="tag" wx:for="{{p.ai_tags.split(',')}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
    </view>
    <view class="desc-actions" wx:if="{{p.id}}">
      <button class="btn-sm" bindtap="generateAIDesc">✨ AI重新生成</button>
      <button class="btn-sm outline" bindtap="copyDesc">📋 复制描述</button>
    </view>
  </view>

  <!-- 照片 -->
  <view class="card" wx:if="{{p.id}}">
    <view class="section-hd"><text class="section-title">📷 房源照片</text><text class="section-more" bindtap="uploadPhoto">+ 添加</text></view>
    <scroll-view class="photo-scroll" scroll-x>
      <view class="photo-item" wx:for="{{photos}}" wx:key="id">
        <image src="{{item.url || item}}" mode="aspectFill" class="photo-img"/>
        <text class="photo-del" bindtap="delPhoto" data-idx="{{idx}}">×</text>
      </view>
      <view class="photo-add" bindtap="uploadPhoto"><text>+</text></view>
    </scroll-view>
    <view class="photo-empty" wx:if="{{photos.length===0}}"><text>暂无照片，点击添加</text></view>
  </view>

  <!-- AI 工具按钮 -->
  <view class="card ai-tools" wx:if="{{p.id}}">
    <view class="section-hd"><text class="section-title">🤖 AI 工具</text></view>
    <view class="ai-btn-row">
      <button class="btn-ai" bindtap="generateAIDesc" loading="{{aiLoading}}" disabled="{{aiLoading}}">✨ AI描述</button>
      <button class="btn-price" bindtap="getPriceSuggest" loading="{{priceLoading}}" disabled="{{priceLoading}}">💰 AI定价</button>
      <button class="btn-poster" bindtap="generatePoster" loading="{{posterLoading}}" disabled="{{posterLoading}}">🖼️ 海报</button>
      <button class="btn-dist" bindtap="distribute" loading="{{distLoading}}" disabled="{{distLoading}}">📤 分发</button>
    </view>
    <view class="ai-result" wx:if="{{aiResult}}">
      <text class="ai-result-label">{{aiResultTitle}}</text>
      <text class="ai-result-text">{{aiResult}}</text>
      <button class="btn-copy" bindtap="copyResult">📋 复制</button>
    </view>
    <!-- 定价建议展示 -->
    <view class="price-card" wx:if="{{priceSuggest}}">
      <view class="price-main">
        <text class="price-label">建议租金</text>
        <text class="price-num">¥{{priceSuggest.suggested_price}}</text>
        <text class="price-range">范围：¥{{priceRangeLow}} ~ ¥{{priceRangeHigh}}<text class="price-conf">（{{priceSuggest.confidence}}置信度）</text></text>
      </view>
      <view class="price-reasons" wx:if="{{priceSuggest && priceSuggest.reasons && priceSuggest.reasons.length}}">
        <text class="price-subtitle">📊 分析理由</text>
        <text class="price-reason" wx:for="{{priceSuggest.reasons}}" wx:for-item="r" wx:key="*this">• {{r}}</text>
      </view>
      <view class="price-tips" wx:if="{{priceSuggest && priceSuggest.tips && priceSuggest.tips.length}}">
        <text class="price-subtitle">💡 提升建议</text>
        <text class="price-tip" wx:for="{{priceSuggest.tips}}" wx:for-item="t" wx:key="*this">• {{t}}</text>
      </view>
      <button class="btn-copy" bindtap="copyPriceResult">📋 复制定价方案</button>
    </view>
  </view>

  <!-- 招租海报预览 -->
  <view class="card poster-card" wx:if="{{posterData}}" catchtap="closePoster">
    <view class="poster-banner">
      <view class="poster-header">
        <text class="poster-headline">{{posterData.headline}}</text>
        <text class="poster-subheadline">{{posterData.subheadline}}</text>
      </view>
      <view class="poster-body">
        <text class="poster-bullet" wx:for="{{posterData.bullets}}" wx:for-item="b" wx:key="*this">✓ {{b}}</text>
      </view>
      <view class="poster-footer">
        <text class="poster-price-tag">{{posterData.price_tag}}</text>
        <text class="poster-cta">{{posterData.cta}}</text>
      </view>
      <view class="poster-watermark">AI安家帮 · 智能招租</view>
    </view>
    <view class="poster-actions">
      <button class="btn-primary" bindtap="posterDone">✅ 使用此海报</button>
      <button class="btn-outline" bindtap="regeneratePoster">🔄 重新生成</button>
    </view>
  </view>

  <view class="card">
    <view class="fld"><text class="lbl">房源名称</text><input class="inp" value="{{p.name}}" bindinput="onField" data-f="name" placeholder="如：徐汇区XX小区A栋"/></view>
    <view class="fld"><text class="lbl">地址</text><input class="inp" value="{{p.address}}" bindinput="onField" data-f="address" placeholder="详细地址"/></view>
    <view class="fld-row">
      <view class="fld"><text class="lbl">城市</text><input class="inp" value="{{p.city}}" bindinput="onField" data-f="city" placeholder="城市"/></view>
      <view class="fld"><text class="lbl">租金(元/月)</text><input class="inp" value="{{p.rent}}" bindinput="onField" data-f="rent" type="number" placeholder="月租金"/></view>
    </view>
    <view class="fld-row">
      <view class="fld"><text class="lbl">面积(㎡)</text><input class="inp" value="{{p.area}}" bindinput="onField" data-f="area" type="digit" placeholder="面积"/></view>
      <view class="fld"><text class="lbl">户型</text>
        <picker class="inp" mode="selector" range="{{roomTypes}}" bindchange="onRoomChange">
          <text>{{p.roomDisplay || '请选择户型'}}</text>
        </picker>
      </view>
    </view>
    <view class="fld"><text class="lbl">备注</text><input class="inp" value="{{p.remark}}" bindinput="onField" data-f="remark" placeholder="备注信息"/></view>
    <button class="btn-save" bindtap="save">保存</button>
    <button class="btn-del" wx:if="{{p.id}}" bindtap="del">删除此房源</button>
  </view>
</scroll-view>
