.page { padding: 30rpx; background: #F5F7FA; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 24rpx; }
.section-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 600; }
.section-more { font-size: 24rpx; color: #2E6BFF; }

/* 出租/出售切换 */
.type-toggle { display: flex; background: #F0F2F5; border-radius: 12rpx; padding: 4rpx; margin-bottom: 24rpx; }
.type-opt { flex: 1; text-align: center; padding: 16rpx; font-size: 26rpx; font-weight: 600; border-radius: 10rpx; color: #6B7A8D; }
.type-opt.active { background: #fff; color: #2E6BFF; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.08); }

.photo-scroll { display: flex; gap: 16rpx; white-space: nowrap; overflow-x: auto; padding-bottom: 10rpx; }
.photo-item { display: inline-block; width: 200rpx; margin-right: 20rpx; vertical-align: top; }
.photo-img { width: 200rpx; height: 200rpx; border-radius: 12rpx; display: block; }
.photo-order { margin-top: 6rpx; }
.cover-badge { font-size: 18rpx; background: #2E6BFF; color: #fff; padding: 2rpx 10rpx; border-radius: 8rpx; }
.photo-ctl { display: flex; gap: 6rpx; margin-top: 6rpx; }
.ctl-btn { flex: 1; padding: 6rpx 0; text-align: center; font-size: 20rpx; border-radius: 6rpx; font-weight: 600; }
.ctl-del { background: #FCEBEB; color: #C62828; }
.ctl-cover { background: #E8F0FF; color: #2E6BFF; }
.ctl-replace { background: #F3E8FF; color: #7C3AED; }
.photo-add { display: inline-flex; width: 200rpx; height: 200rpx; border: 4rpx dashed #E4E9F0; border-radius: 12rpx; align-items: center; justify-content: center; font-size: 60rpx; color: #6B7A8D; }
.photo-empty { text-align: center; padding: 40rpx; color: #6B7A8D; font-size: 24rpx; }

.fld { margin-bottom: 24rpx; flex: 1; }
.fld-row { display: flex; gap: 20rpx; }
.lbl { display: block; font-size: 26rpx; font-weight: 500; color: #1E2A3B; margin-bottom: 8rpx; }
.inp { width: 100%; padding: 20rpx 24rpx; border: 2rpx solid #E4E9F0; border-radius: 12rpx; font-size: 28rpx; background: #FAFBFC; color: #1E2A3B; }
.btn-save { width: 100%; padding: 24rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; margin-top: 20rpx; }
.btn-del { width: 100%; padding: 24rpx; background: #fff; color: #FF6B6B; border: 2rpx solid #FF6B6B; border-radius: 12rpx; font-size: 28rpx; margin-top: 16rpx; }

.tenant-card { border: 2rpx solid #2E6BFF; }
.t-info { }
.t-row { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid #F0F2F5; font-size: 26rpx; }
.t-lbl { width: 140rpx; color: #6B7A8D; flex-shrink: 0; }
.t-val { flex: 1; color: #1E2A3B; font-weight: 500; }
.t-val.urgent { color: #FFB020; }
.t-val.expired { color: #FF6B6B; }
.t-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-renew { flex: 1; padding: 20rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 12rpx; font-size: 26rpx; }
.btn-view-bills { flex: 1; padding: 20rpx; background: #E8F0FF; color: #2E6BFF; border: none; border-radius: 12rpx; font-size: 26rpx; }

/* AI 工具 */
.ai-tools { }
.ai-btn-row { display: flex; gap: 16rpx; }
.btn-ai { flex: 1; padding: 22rpx; border: none; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; text-align: center; background: linear-gradient(135deg,#2E6BFF,#6C5CE7); color: #fff; }
.btn-price { flex: 1; padding: 22rpx; border: none; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; text-align: center; background: linear-gradient(135deg,#FF6B6B,#FF8E53); color: #fff; }
.btn-poster { flex: 1; padding: 22rpx; border: none; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; text-align: center; background: linear-gradient(135deg,#A855F7,#6C5CE7); color: #fff; }
.btn-dist { flex: 1; padding: 22rpx; border: none; border-radius: 12rpx; font-size: 24rpx; font-weight: 600; text-align: center; background: linear-gradient(135deg,#00C48C,#0F6E56); color: #fff; }
.ai-result { margin-top: 20rpx; padding: 20rpx; background: #F8FAFB; border-radius: 12rpx; border: 2rpx solid #E4E9F0; }
.ai-result-label { display: block; font-size: 22rpx; font-weight: 600; color: #2E6BFF; margin-bottom: 8rpx; }
.ai-result-text { display: block; font-size: 24rpx; color: #1E2A3B; line-height: 1.6; white-space: pre-wrap; }
.btn-copy { margin-top: 12rpx; padding: 12rpx 24rpx; background: #E8F0FF; color: #2E6BFF; border: none; border-radius: 8rpx; font-size: 22rpx; }

/* 房源描述区 */
.desc-text { display: block; font-size: 26rpx; color: #1E2A3B; line-height: 1.8; margin-bottom: 16rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 16rpx; }
.tag { font-size: 22rpx; padding: 6rpx 16rpx; background: #E8F0FF; color: #2E6BFF; border-radius: 20rpx; }
.desc-actions { display: flex; gap: 16rpx; }
.btn-sm { flex: 1; padding: 16rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 10rpx; font-size: 24rpx; text-align: center; }
.btn-sm.outline { background: #fff; color: #2E6BFF; border: 2rpx solid #2E6BFF; }

/* 价格区间修复 */
.price-card .price-range .price-conf { margin-left: 8rpx; }

/* 定价建议卡片 */
.price-card { margin-top: 20rpx; padding: 24rpx; background: linear-gradient(135deg,#FFFBEB,#FFF3E0); border-radius: 16rpx; border: 2rpx solid #FFE0A0; }
.price-main { text-align: center; padding: 16rpx 0; }
.price-label { font-size: 22rpx; color: #B8860B; }
.price-num { display: block; font-size: 64rpx; font-weight: 700; color: #E65100; line-height: 1.2; }
.price-range { display: block; font-size: 22rpx; color: #8D6E3F; margin-top: 8rpx; }
.price-conf { color: #2E6BFF; }
.price-subtitle { display: block; font-size: 24rpx; font-weight: 600; color: #1E2A3B; margin: 16rpx 0 8rpx; }
.price-reason, .price-tip { display: block; font-size: 24rpx; color: #4A5568; line-height: 1.8; padding-left: 8rpx; }

/* 招租海报 */
.poster-card { padding: 0; overflow: hidden; background: none; }
.poster-banner { background: linear-gradient(135deg,#1A1A2E,#16213E,#0F3460); padding: 40rpx 36rpx; color: #fff; }
.poster-header { margin-bottom: 30rpx; }
.poster-headline { display: block; font-size: 44rpx; font-weight: 800; line-height: 1.3; }
.poster-subheadline { display: block; font-size: 28rpx; color: rgba(255,255,255,0.7); margin-top: 8rpx; }
.poster-body { margin: 24rpx 0; }
.poster-bullet { display: block; font-size: 26rpx; padding: 10rpx 0; color: rgba(255,255,255,0.9); }
.poster-footer { margin-top: 30rpx; display: flex; justify-content: space-between; align-items: center; }
.poster-price-tag { font-size: 50rpx; font-weight: 800; background: linear-gradient(135deg,#F7971E,#FFD200); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.poster-cta { padding: 12rpx 28rpx; background: rgba(255,255,255,0.15); border: 2rpx solid rgba(255,255,255,0.3); border-radius: 30rpx; font-size: 24rpx; }
.poster-watermark { text-align: center; font-size: 18rpx; color: rgba(255,255,255,0.3); margin-top: 24rpx; }
.poster-actions { display: flex; gap: 16rpx; padding: 20rpx; background: #fff; }
.btn-outline { flex: 1; padding: 20rpx; background: #fff; color: #2E6BFF; border: 2rpx solid #2E6BFF; border-radius: 12rpx; font-size: 26rpx; text-align: center; }
