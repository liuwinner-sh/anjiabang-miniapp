.page { padding: 20rpx 24rpx 140rpx; background: #F5F7FA; min-height: 100vh; }

/* 顶部统计卡片 */
.stats-bar { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.stat-card { flex: 1; border-radius: 16rpx; padding: 20rpx 16rpx; text-align: center; }
.stat-card.total { background: linear-gradient(135deg,#2E6BFF,#5B8DEF); }
.stat-card.paid { background: linear-gradient(135deg,#00C48C,#34D399); }
.stat-card.pending { background: linear-gradient(135deg,#F59E0B,#FBBF24); }
.stat-num { display: block; font-size: 28rpx; font-weight: 700; color: #fff; }
.stat-num.warn { color: #fff; }
.stat-lbl { display: block; font-size: 20rpx; color: rgba(255,255,255,.8); margin-top: 4rpx; }

/* 工具栏 */
.toolbar { display: flex; gap: 12rpx; margin-bottom: 20rpx; align-items: center; }
.search-box { flex: 1; display: flex; align-items: center; background: #fff; border-radius: 12rpx; padding: 0 16rpx; height: 72rpx; border: 2rpx solid #E4E9F0; }
.search-icon { font-size: 28rpx; margin-right: 8rpx; }
.search-input { flex: 1; font-size: 26rpx; color: #1E2A3B; }
.btn-add { flex-shrink: 0; height: 72rpx; line-height: 72rpx; padding: 0 24rpx; background: #2E6BFF; color: #fff; border-radius: 12rpx; font-size: 26rpx; font-weight: 500; border: none; }

/* 账单列表 */
.bill-list { }
.bill-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; position: relative; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.bill-body { display: flex; justify-content: space-between; }
.bill-left { display: flex; align-items: center; gap: 16rpx; }
.bill-type-icon { width: 56rpx; height: 56rpx; border-radius: 50%; background: #F0F2F5; display: flex; align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0; }
.bill-info { flex: 1; }
.bill-prop { display: block; font-size: 28rpx; font-weight: 600; color: #1E2A3B; }
.bill-month { display: block; font-size: 22rpx; color: #6B7A8D; margin-top: 4rpx; }
.bill-right { position: absolute; right: 24rpx; top: 24rpx; text-align: right; }
.bill-amount { display: block; font-size: 30rpx; font-weight: 700; }
.bill-amount.paid { color: #0F6E56; }
.bill-amount.pending { color: #B8860B; }
.bill-status { display: inline-block; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 16rpx; margin-top: 6rpx; }
.bill-status.paid { background: #E1F5EE; color: #0F6E56; }
.bill-status.pending { background: #FAEEDA; color: #633806; }

.bill-actions { display: flex; gap: 12rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 2rpx solid #F0F2F5; }
.act-btn { flex: 1; height: 60rpx; line-height: 60rpx; border-radius: 10rpx; font-size: 24rpx; text-align: center; border: none; }
.act-btn.pay { background: #E1F5EE; color: #0F6E56; }
.act-btn.edit { background: #E8F0FF; color: #2E6BFF; }
.act-btn.del { background: #FCEBEB; color: #C62828; }
.form-static { display: block; font-size: 26rpx; color: #1E2A3B; padding: 8rpx 0; }
.empty-sub { font-size: 22rpx; color: #9CA3AF; margin-top: 8rpx; }

/* 加载更多 */
.load-more { text-align: center; padding: 24rpx; font-size: 24rpx; color: #2E6BFF; }
.load-more:active { opacity: 0.5; }

/* 空状态 */
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { font-size: 26rpx; color: #6B7A8D; margin-top: 16rpx; }

/* 弹窗 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 200; }
.modal { position: fixed; left: 32rpx; right: 32rpx; bottom: 80rpx; background: #fff; border-radius: 20rpx; z-index: 201; max-height: 70vh; overflow-y: auto; }
.modal-hd { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 28rpx 0; }
.modal-title { font-size: 30rpx; font-weight: 700; }
.modal-close { font-size: 36rpx; color: #9CA3AF; padding: 8rpx; }
.modal-bd { padding: 24rpx 28rpx; }
.modal-ft { display: flex; gap: 16rpx; padding: 0 28rpx 28rpx; }
.btn-cancel { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; background: #F0F2F5; color: #6B7A8D; font-size: 28rpx; text-align: center; border: none; }
.btn-primary { flex: 1; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; background: #2E6BFF; color: #fff; font-size: 28rpx; text-align: center; border: none; }

.form-group { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 24rpx; color: #6B7A8D; margin-bottom: 8rpx; }
.form-input { width: 100%; height: 72rpx; border: 2rpx solid #E4E9F0; border-radius: 12rpx; padding: 0 16rpx; font-size: 26rpx; box-sizing: border-box; }
.picker-box { height: 72rpx; line-height: 72rpx; border: 2rpx solid #E4E9F0; border-radius: 12rpx; padding: 0 16rpx; font-size: 26rpx; color: #1E2A3B; }
