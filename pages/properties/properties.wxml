<scroll-view class="page" scroll-y refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
  <view class="toolbar">
    <input class="search" placeholder="搜索房源..." value="{{keyword}}" bindinput="onSearch"/>
    <button class="btn-add" bindtap="addProperty">+ 添加</button>
  </view>

  <view class="list">
    <view class="item" wx:for="{{list}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}">
      <view class="item-top">
        <text class="item-name">{{item.name}}</text>
        <view class="item-tags">
          <text class="item-type {{item.property_type}}">{{item.property_type==='sell'?'出售':'出租'}}</text>
          <text class="item-status {{item.status}}">{{item.status==='rented'?'已租':item.status==='active'?'待租':item.status==='sold'?'已售':item.status}}</text>
        </view>
      </view>
      <text class="item-addr">{{item.address || '地址未填'}}</text>
      <view class="item-bottom">
        <text class="item-price">{{item.property_type==='sell'?'¥'+item.price+'万':'¥'+item.price+'/月'}}</text>
        <text class="item-spec">{{item.room||'?'}}室{{item.hall||'?'}}厅 · {{item.area||'?'}}㎡</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{list.length===0}}">
    <text>暂无房源</text>
    <button class="btn-add" bindtap="addProperty">+ 添加第一套房源</button>
  </view>
</scroll-view>
