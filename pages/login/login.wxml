<view class="page">
  <view class="card">
    <view class="logo">
      <text class="logo-icon">🏠</text>
      <text class="logo-title">AI安家帮</text>
      <text class="logo-desc">智能房东租务管理平台</text>
    </view>
    
    <view class="tabs">
      <view class="tab {{tab==='login'?'on':''}}" bindtap="switchTab" data-tab="login">登录</view>
      <view class="tab {{tab==='reg'?'on':''}}" bindtap="switchTab" data-tab="reg">注册</view>
    </view>

    <!-- 登录 -->
    <view class="form" wx:if="{{tab==='login'}}">
      <view class="fld">
        <text class="label">手机号</text>
        <input class="inp" type="number" placeholder="请输入手机号" placeholder-class="ph" value="{{phone}}" bindinput="onPhone" maxlength="11" adjust-position="false"/>
      </view>
      <view class="fld">
        <text class="label">密码</text>
        <input class="inp" type="password" placeholder="请输入密码" placeholder-class="ph" value="{{pwd}}" bindinput="onPwd" adjust-position="false"/>
      </view>
      <view class="fld-actions">
        <text class="link" catchtap="forgotPwd">忘记密码？</text>
      </view>
      <button class="btn" bindtap="doLogin" loading="{{loading}}">{{loading?'登录中...':'登 录'}}</button>
      <text class="msg {{msgType}}">{{msg}}</text>
    </view>

    <!-- 重置密码 -->
    <view class="form" wx:elif="{{tab==='reset'}}">
      <view class="fld">
        <text class="label">手机号</text>
        <input class="inp" type="text" placeholder="请输入注册时的手机号" placeholder-class="ph" value="{{resetPhone}}" bindinput="onResetPhone" maxlength="11"/>
      </view>
      <view class="fld">
        <text class="label">新密码</text>
        <input class="inp" type="password" placeholder="设置新密码（6位以上）" placeholder-class="ph" value="{{resetPwd}}" bindinput="onResetPwd"/>
      </view>
      <view class="fld">
        <text class="label">确认密码</text>
        <input class="inp" type="password" placeholder="再次输入新密码" placeholder-class="ph" value="{{resetPwd2}}" bindinput="onResetPwd2"/>
      </view>
      <button class="btn" bindtap="doReset" loading="{{resetLoading}}">{{resetLoading?'重置中...':'重置密码'}}</button>
      <text class="msg {{resetMsgType}}">{{resetMsg}}</text>
      <text class="link" catchtap="switchTab" data-tab="login">← 返回登录</text>
    </view>

    <!-- 注册 -->
    <view class="form" wx:else>
      <view class="fld">
        <text class="label">手机号</text>
        <input class="inp" type="text" placeholder="请输入手机号" placeholder-class="ph" value="{{regPhone}}" bindinput="onRegPhone" maxlength="11"/>
      </view>
      <view class="fld">
        <text class="label">密码</text>
        <input class="inp" type="password" placeholder="设置密码（6位以上）" placeholder-class="ph" value="{{regPwd}}" bindinput="onRegPwd"/>
      </view>
      <view class="fld">
        <text class="label">确认密码</text>
        <input class="inp" type="password" placeholder="再次输入" placeholder-class="ph" value="{{regPwd2}}" bindinput="onRegPwd2"/>
      </view>
      <view class="fld">
        <text class="label">称呼</text>
        <input class="inp" type="text" placeholder="怎么称呼您" placeholder-class="ph" value="{{regName}}" bindinput="onRegName"/>
      </view>
      <button class="btn" bindtap="doReg" loading="{{regLoading}}">{{regLoading?'注册中...':'注 册'}}</button>
      <text class="msg {{regMsgType}}">{{regMsg}}</text>
    </view>
  </view>
</view>
