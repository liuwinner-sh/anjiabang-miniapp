.page { padding: 30rpx; background: #F5F7FA; min-height: 100vh; }
.page-hd { margin-bottom: 16rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #6B7A8D; margin-top: 6rpx; line-height: 1.5; }

/* 提示条 */
.nav-hint { display: flex; align-items: flex-start; gap: 8rpx; padding: 14rpx 18rpx; background: #E8F0FF; border-radius: 12rpx; margin-bottom: 16rpx; font-size: 22rpx; }
.nh-icon { font-size: 24rpx; flex-shrink: 0; margin-top: 2rpx; }
.nh-text { color: #2E6BFF; line-height: 1.5; }

/* 筛选 */
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.filter-item { padding: 10rpx 22rpx; background: #fff; border-radius: 30rpx; font-size: 22rpx; color: #6B7A8D; }
.filter-item.f-active { background: #2E6BFF; color: #fff; font-weight: 600; }

/* 新增按钮 */
.btn-add-full { display: flex; flex-direction: column; align-items: center; width: 100%; padding: 24rpx; background: linear-gradient(135deg, #2E6BFF, #5B8DFF); color: #fff; border: none; border-radius: 16rpx; font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.btn-add-full .btn-sub { font-size: 22rpx; opacity: .8; font-weight: 400; margin-top: 4rpx; }

/* 卡片列表 */
.list { display: flex; flex-direction: column; gap: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8rpx; }
.card-name { font-size: 28rpx; font-weight: 600; }
.card-phone { font-size: 22rpx; color: #6B7A8D; margin-left: 8rpx; }
.card-demand { font-size: 24rpx; color: #333; margin-bottom: 8rpx; line-height: 1.5; }
.card-tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-bottom: 8rpx; }
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.card-time { font-size: 20rpx; color: #999; }
.card-actions { display: flex; gap: 8rpx; }
.card-status { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }

/* 标签 */
.tag { display: inline-block; padding: 4rpx 12rpx; border-radius: 16rpx; font-size: 20rpx; }
.tag-orange { background: #FAEEDA; color: #633806; }
.tag-blue { background: #E8F0FF; color: #2E6BFF; }
.tag-green { background: #E1F5EE; color: #0F6E56; }
.tag-gray { background: #F0F2F5; color: #6B7A8D; }

.card-status.tag-blue { background: #E8F0FF; color: #2E6BFF; }
.card-status.tag-orange { background: #FAEEDA; color: #633806; }
.card-status.tag-green { background: #E1F5EE; color: #0F6E56; }
.card-status.tag-gray { background: #F0F2F5; color: #6B7A8D; }

/* 小按钮 */
.btn-tiny { padding: 8rpx 20rpx; border: none; border-radius: 8rpx; font-size: 22rpx; }
.btn-blue { background: #2E6BFF; color: #fff; }
.btn-outline { background: #F5F7FA; color: #2E6BFF; border: 2rpx solid #E0E4EA; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; }
.modal { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 101; padding: 30rpx; max-height: 80vh; overflow-y: auto; }
.chat-modal { max-height: 85vh; }
.modal-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.modal-title { font-size: 30rpx; font-weight: 700; }
.modal-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.modal-bd { margin-bottom: 24rpx; }
.modal-ft { display: flex; gap: 16rpx; }

.form-label { display: block; font-size: 26rpx; color: #333; font-weight: 500; margin-bottom: 8rpx; margin-top: 20rpx; }
.form-input { width: 100%; padding: 20rpx; background: #F5F7FA; border: none; border-radius: 12rpx; font-size: 26rpx; box-sizing: border-box; color: #333; }
.form-input.area { min-height: 100rpx; }
.form-tip { display: block; font-size: 22rpx; color: #999; margin-top: 8rpx; }

.btn-primary { width: 100%; padding: 22rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.btn-cancel { flex: 1; padding: 22rpx; background: #F5F7FA; color: #6B7A8D; border: none; border-radius: 12rpx; font-size: 28rpx; }

.btn-sm-block { margin-top: 12rpx; margin-bottom: 16rpx; width: 100%; }

/* 聊天总结 */
.chat-section { border-bottom: 2rpx solid #F0F2F5; padding-bottom: 24rpx; margin-bottom: 24rpx; }
.chat-section:last-child { border: none; margin: 0; padding: 0; }
.chat-section-title { display: block; font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.summary-box { padding: 16rpx; background: #F5F7FA; border-radius: 12rpx; }
.summary-text { font-size: 24rpx; color: #333; line-height: 1.5; display: block; }
.mood-tag { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; font-size: 24rpx; }
.action-list { margin-top: 12rpx; }
.action-title { display: block; font-size: 24rpx; font-weight: 500; margin-bottom: 6rpx; }
.action-item { display: block; font-size: 22rpx; color: #D4880F; margin-bottom: 4rpx; }
.reply-box { padding: 16rpx; background: #E1F5EE; border-radius: 12rpx; margin-top: 12rpx; display: flex; justify-content: space-between; align-items: flex-start; }
.reply-text { font-size: 24rpx; color: #0F6E56; flex: 1; line-height: 1.5; }

.empty { text-align: center; padding: 80rpx 0; color: #6B7A8D; font-size: 28rpx; }
