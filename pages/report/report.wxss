.page { padding: 30rpx 30rpx 120rpx; background: #F5F7FA; min-height: 100vh; }
.page-hd { margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #6B7A8D; margin-top: 6rpx; }

.summary-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.sum-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx; text-align: center; }
.sum-lbl { font-size: 22rpx; color: #6B7A8D; display: block; margin-bottom: 8rpx; }
.sum-num { font-size: 32rpx; font-weight: 700; display: block; }
.sum-num.primary { color: #2E6BFF; }
.sum-num.green { color: #00C48C; }
.sum-num.red { color: #FF6B6B; }

.year-selector { display: flex; align-items: center; justify-content: center; gap: 40rpx; margin-bottom: 24rpx; }
.year-btn { font-size: 48rpx; color: #2E6BFF; padding: 10rpx 20rpx; font-weight: 700; }
.year-text { font-size: 32rpx; font-weight: 600; }

.section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-hd { margin-bottom: 20rpx; display: flex; justify-content: space-between; align-items: center; }
.section-title { font-size: 28rpx; font-weight: 600; }
.section-more { font-size: 22rpx; color: #2E6BFF; font-weight: 500; }

.legend { font-size: 22rpx; color: #6B7A8D; margin-bottom: 16rpx; }
.dot { display: inline-block; width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot.blue { background: #2E6BFF; }
.dot.orange { background: #FFB020; }

.chart { display: flex; align-items: flex-end; gap: 16rpx; height: 300rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; position: relative; }
.chart-col:active { opacity: 0.7; }
.bars { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 4rpx; justify-content: flex-end; height: 100%; }
.bar { width: 60%; max-width: 40rpx; border-radius: 6rpx 6rpx 0 0; position: relative; min-height: 4rpx; }
.bar.blue { background: linear-gradient(180deg,#2E6BFF,#5B8DFF); }
.bar.orange { background: linear-gradient(180deg,#FFB020,#FFD666); }
.bar-val { position: absolute; top: -30rpx; left: 50%; transform: translateX(-50%); font-size: 16rpx; color: #2E6BFF; white-space: nowrap; }
.col-lbl { font-size: 20rpx; color: #6B7A8D; margin-top: 8rpx; }
.chart-hint { display: block; text-align: center; font-size: 20rpx; color: #9CA3AF; margin-top: 12rpx; }

.month-item { padding: 20rpx 0; border-bottom: 2rpx solid #F0F2F5; }
.month-item:last-child { border-bottom: none; }
.mi-hd { display: flex; justify-content: space-between; align-items: center; }
.mi-month { font-size: 26rpx; font-weight: 600; }
.mi-total { font-size: 28rpx; font-weight: 700; color: #2E6BFF; }
.mi-detail { display: flex; gap: 24rpx; margin-top: 8rpx; font-size: 22rpx; color: #6B7A8D; }

.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; display: flex; background: #fff; border-top: 2rpx solid #E4E9F0; padding-bottom: env(safe-area-inset-bottom); z-index: 100; }
.nav-item { flex: 1; padding: 12rpx 0; text-align: center; font-size: 20rpx; color: #6B7A8D; }
.nav-item text:first-child { font-size: 40rpx; display: block; margin-bottom: 4rpx; }
.nav-item.on { color: #2E6BFF; }
