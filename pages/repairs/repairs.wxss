.page { padding: 30rpx; background: #F5F7FA; min-height: 100vh; }
.page-hd { margin-bottom: 20rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-desc { font-size: 24rpx; color: #6B7A8D; margin-top: 6rpx; }

/* 筛选 */
.filter-bar { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.filter-item { padding: 12rpx 28rpx; background: #fff; border-radius: 30rpx; font-size: 24rpx; color: #6B7A8D; }
.filter-item.f-active { background: #2E6BFF; color: #fff; font-weight: 600; }

/* 新增按钮 */
.btn-add-full { display: flex; flex-direction: column; align-items: center; width: 100%; padding: 24rpx; background: linear-gradient(135deg, #2E6BFF, #5B8DFF); color: #fff; border: none; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.btn-add-full .btn-sub { font-size: 22rpx; opacity: .8; font-weight: 400; margin-top: 4rpx; }

/* 卡片列表 */
.list { display: flex; flex-direction: column; gap: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8rpx; }
.card-name { font-size: 28rpx; font-weight: 600; flex: 1; word-break: break-all; }
.card-info { font-size: 24rpx; color: #6B7A8D; margin-bottom: 8rpx; }
.card-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 8rpx; }
.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.card-time { font-size: 20rpx; color: #999; }

/* 标签 */
.tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 20rpx; font-size: 20rpx; }
.tag-orange { background: #FAEEDA; color: #633806; }
.tag-blue { background: #E8F0FF; color: #2E6BFF; }
.tag-green { background: #E1F5EE; color: #0F6E56; }
.card-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; }
.card-status.tag-green { background: #E1F5EE; color: #0F6E56; }
.card-status.tag-orange { background: #FAEEDA; color: #633806; }
.card-status.tag-blue { background: #E8F0FF; color: #2E6BFF; }

.urgency-danger { background: #FCEBEB; color: #791F1F; }
.urgency-warn { background: #FAEEDA; color: #633806; }
.urgency-normal { background: #E1F5EE; color: #0F6E56; }

/* 小按钮 */
.btn-tiny { padding: 8rpx 20rpx; border: none; border-radius: 8rpx; font-size: 22rpx; }
.btn-green { background: #E1F5EE; color: #0F6E56; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 100; }
.modal { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 101; max-height: 80vh; overflow-y: auto; padding: 30rpx; }
.diag-modal { max-height: 85vh; }
.modal-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.modal-title { font-size: 32rpx; font-weight: 700; }
.modal-close { font-size: 36rpx; color: #999; padding: 8rpx; }
.modal-bd { margin-bottom: 24rpx; }
.modal-ft { display: flex; gap: 16rpx; }

/* 表单 */
.form-label { display: block; font-size: 26rpx; color: #333; font-weight: 500; margin-bottom: 8rpx; margin-top: 20rpx; }
.form-input { width: 100%; padding: 20rpx; background: #F5F7FA; border: none; border-radius: 12rpx; font-size: 26rpx; box-sizing: border-box; color: #333; }
.form-input.area { min-height: 120rpx; }
.form-picker { width: 100%; }
.picker-box { padding: 20rpx; background: #F5F7FA; border-radius: 12rpx; font-size: 26rpx; color: #333; }

/* 诊断结果 */
.diag-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 2rpx solid #F0F2F5; }
.diag-label { font-size: 26rpx; color: #6B7A8D; }
.diag-val { font-size: 26rpx; font-weight: 500; }
.diag-price { font-size: 32rpx; color: #E54545; font-weight: 700; }
.diag-section { display: block; font-size: 26rpx; font-weight: 600; margin-top: 20rpx; margin-bottom: 12rpx; }
.cause-item { padding: 12rpx 16rpx; background: #F5F7FA; border-radius: 12rpx; margin-bottom: 8rpx; display: flex; gap: 12rpx; flex-wrap: wrap; align-items: center; }
.cause-name { font-size: 24rpx; font-weight: 500; flex: 1; }
.cause-prob { font-size: 20rpx; color: #D4880F; }
.cause-cost { font-size: 20rpx; color: #E54545; }
.diag-pitfall { display: block; padding: 16rpx; background: #FCEBEB; border-radius: 12rpx; font-size: 24rpx; color: #791F1F; margin-bottom: 12rpx; }
.diag-complete { margin-top: 20rpx; padding-top: 20rpx; border-top: 2rpx solid #F0F2F5; }

/* 按钮 */
.btn-primary { flex: 1; padding: 22rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.btn-cancel { flex: 1; padding: 22rpx; background: #F5F7FA; color: #6B7A8D; border: none; border-radius: 12rpx; font-size: 28rpx; }

.empty { text-align: center; padding: 80rpx 0; color: #6B7A8D; font-size: 28rpx; }
