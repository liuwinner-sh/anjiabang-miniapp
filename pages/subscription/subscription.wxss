.page { padding: 24rpx 20rpx 40rpx; background: #F5F7FA; min-height: 100vh; }

/* 页头 */
.hd { margin-bottom: 24rpx; }
.hd-title { font-size: 34rpx; font-weight: 800; color: #1E2A3B; }
.hd-desc { font-size: 24rpx; color: #6B7A8D; margin-top: 6rpx; }

/* 当前套餐卡片 */
.current-card { background: linear-gradient(135deg,#2E6BFF,#6C5CE7); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; color: #fff; }
.cc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.cc-plan { font-size: 32rpx; font-weight: 700; }
.cc-badge { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 20rpx; background: rgba(255,255,255,.2); }
.cc-badge.active { background: rgba(0,196,140,.4); }
.cc-usage { }
.cc-bar-wrap { height: 12rpx; background: rgba(255,255,255,.2); border-radius: 6rpx; overflow: hidden; margin-bottom: 8rpx; }
.cc-bar { height: 100%; background: #fff; border-radius: 6rpx; transition: width 0.5s; }
.cc-text { font-size: 22rpx; opacity: .8; }
.cc-expire { font-size: 20rpx; opacity: .6; margin-top: 8rpx; display: block; }

/* 套餐网格 */
.plan-grid { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.plan-card { background: #fff; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #F0F2F5; position: relative; }
.plan-card.current { border-color: #2E6BFF; background: #F8FBFF; }
.pc-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.pc-name { font-size: 28rpx; font-weight: 700; }
.pc-price { font-size: 36rpx; font-weight: 800; color: #E54545; }
.pc-price.free { color: #00C48C; }
.pc-unit { font-size: 20rpx; font-weight: 400; color: #999; }
.pc-features { margin-bottom: 16rpx; }
.pc-feat { display: block; font-size: 22rpx; color: #4A5568; padding: 4rpx 0; }
.pc-badge { position: absolute; top: 16rpx; right: 16rpx; font-size: 20rpx; padding: 4rpx 14rpx; background: #2E6BFF; color: #fff; border-radius: 20rpx; }
.pc-btn { width: 100%; padding: 18rpx; border: 2rpx solid #2E6BFF; border-radius: 12rpx; background: #fff; color: #2E6BFF; font-size: 26rpx; font-weight: 600; text-align: center; }
.pc-btn.free-btn { border-color: #00C48C; color: #00C48C; }
.pc-btn.current-btn { border-color: #B0B8C5; color: #B0B8C5; background: #F5F7FA; }

/* 使用统计 */
.section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 26rpx; font-weight: 700; display: block; margin-bottom: 16rpx; color: #1E2A3B; }
.usage-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 2rpx solid #F5F7FA; font-size: 24rpx; }
.usage-item:last-child { border: none; }
.us-name { color: #1E2A3B; }
.us-count { color: #6B7A8D; }
.usage-empty { text-align: center; padding: 30rpx; color: #B0B8C5; font-size: 24rpx; }

/* 弹窗 */
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 100; }
.modal { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; z-index: 101; padding: 30rpx; }
.modal-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.modal-title { font-size: 28rpx; font-weight: 700; }
.modal-close { font-size: 36rpx; color: #6B7A8D; padding: 8rpx; }
.modal-bd { margin-bottom: 24rpx; text-align: center; }
.confirm-plan { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.confirm-price { font-size: 48rpx; font-weight: 800; color: #E54545; display: block; }
.confirm-price.free { color: #00C48C; }
.confirm-unit { font-size: 24rpx; font-weight: 400; color: #999; }
.confirm-desc { font-size: 24rpx; color: #4A5568; margin-top: 12rpx; display: block; }
.confirm-note { font-size: 22rpx; color: #FFB020; margin-top: 8rpx; display: block; }
.modal-ft { display: flex; gap: 16rpx; }
.btn-primary { flex: 1; padding: 22rpx; background: #2E6BFF; color: #fff; border: none; border-radius: 12rpx; font-size: 28rpx; font-weight: 600; }
.btn-cancel { flex: 1; padding: 22rpx; background: #F5F7FA; color: #6B7A8D; border: none; border-radius: 12rpx; font-size: 28rpx; }
