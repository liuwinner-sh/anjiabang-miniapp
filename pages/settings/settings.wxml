<view class="page">
  <!-- 用户信息卡 -->
  <view class="card user-card">
    <view class="uc-avatar-wrap" bindtap="changeAvatar">
      <image class="uc-avatar" wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill"/>
      <view class="uc-avatar uc-avatar-fallback" wx:else>{{userInitial}}</view>
      <view class="uc-avatar-overlay"><text>📷</text></view>
    </view>
    <view class="uc-info">
      <view class="uc-name-row" bindtap="editName">
        <text class="uc-name">{{editNameVal || userName}}</text>
        <text class="uc-edit-icon">✏️</text>
      </view>
      <text class="uc-phone">{{userPhone}}</text>
      <view class="uc-tag" wx:if="{{userRole}}">{{userRole}}</view>
    </view>
  </view>

  <!-- 编辑姓名弹窗 -->
  <view class="modal-mask" wx:if="{{showNameEditor}}" bindtap="closeNameEditor"></view>
  <view class="modal name-modal" wx:if="{{showNameEditor}}">
    <view class="modal-hd">
      <text class="modal-title">修改昵称</text>
      <text class="modal-close" bindtap="closeNameEditor">✕</text>
    </view>
    <view class="modal-bd">
      <input class="form-input" placeholder="输入新昵称" value="{{editNameVal}}" bindinput="onNameInput" maxlength="20"/>
    </view>
    <view class="modal-ft">
      <button class="btn-cancel" bindtap="closeNameEditor">取消</button>
      <button class="btn-primary" bindtap="saveName">保存</button>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="changePwd"><text class="mi-icon">🔑</text><text class="mi-txt">修改密码</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="showReport"><text class="mi-icon">📊</text><text class="mi-txt">收支报表</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goUtilities"><text class="mi-icon">🔌</text><text class="mi-txt">水电煤</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goRepairs"><text class="mi-icon">🔧</text><text class="mi-txt">维修报修</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goFiling"><text class="mi-icon">📋</text><text class="mi-txt">合同备案</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goCustomers"><text class="mi-icon">👤</text><text class="mi-txt">客户管理</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goSubscription"><text class="mi-icon">💳</text><text class="mi-txt">套餐订阅</text><text class="mi-arrow">›</text></view>
  </view>

  <button class="logout" bindtap="doLogout">退出登录</button>

  <!-- ===== 修改密码弹窗 ===== -->
  <view class="modal-mask" wx:if="{{showPwd}}" bindtap="closePwd"></view>
  <view class="modal" wx:if="{{showPwd}}">
    <view class="modal-hd">
      <text class="modal-title">🔑 修改密码</text>
      <text class="modal-close" bindtap="closePwd">✕</text>
    </view>
    <view class="modal-bd">
      <text class="form-label">旧密码</text>
      <input class="form-input" password placeholder="输入当前密码" value="{{oldPwd}}" bindinput="onPwdField" data-f="oldPwd"/>
      <text class="form-label">新密码</text>
      <input class="form-input" password placeholder="至少6位" value="{{newPwd}}" bindinput="onPwdField" data-f="newPwd"/>
      <text class="form-label">确认新密码</text>
      <input class="form-input" password placeholder="再次输入新密码" value="{{confirmPwd}}" bindinput="onPwdField" data-f="confirmPwd"/>
    </view>
    <view class="modal-ft">
      <button class="btn-cancel" bindtap="closePwd">取消</button>
      <button class="btn-primary" bindtap="doChangePwd">确认修改</button>
    </view>
  </view>

  <!-- ===== 套餐订阅弹窗 ===== -->
  <view class="modal-mask" wx:if="{{showSub}}" bindtap="closeSub"></view>
  <view class="modal sub-modal" wx:if="{{showSub}}">
    <view class="modal-hd">
      <text class="modal-title">💳 套餐订阅</text>
      <text class="modal-close" bindtap="closeSub">✕</text>
    </view>
    <view class="modal-bd">
      <text class="current-plan" wx:if="{{currentPlan}}">
        当前套餐：<text class="plan-name">{{planDesc[currentPlan.plan] || currentPlan.plan || '免费版'}}</text>
        <text wx:if="{{currentPlan.used_this_month !== undefined}}">（已用{{currentPlan.used_this_month}}次/{{currentPlan.monthly_limit}}次）</text>
      </text>

      <view class="plan-list">
        <view class="plan-card {{currentPlan.plan===item.id?'plan-current':''}}" wx:for="{{plans}}" wx:key="id" wx:for-item="item" catchtap="doUpgrade" data-plan="{{item.id}}">
          <view class="plan-hd">
            <text class="plan-name">{{item.name}}</text>
            <text class="plan-price" wx:if="{{item.price>0}}">¥{{item.price}}<text class="plan-unit">/月</text></text>
            <text class="plan-price free" wx:if="{{item.price===0}}">免费</text>
          </view>
          <text class="plan-desc">{{planDesc[item.id] || item.name}}</text>
          <text class="plan-badge" wx:if="{{currentPlan.plan===item.id}}">当前</text>
        </view>
      </view>
    </view>
  </view>
</view>
