<view class="page">
  <!-- 用户信息卡 -->
  <view class="card user-card">
    <view class="uc-avatar-wrap" bindtap="changeAvatar">
      <image class="uc-avatar" wx:if="{{userAvatar}}" src="{{userAvatar}}" mode="aspectFill"/>
      <view class="uc-avatar uc-avatar-fallback" wx:else>{{userInitial}}</view>
      <view class="uc-avatar-overlay"><text>📷</text></view>
    </view>
    <view class="uc-info">
      <view class="uc-name-row" bindtap="editName">
        <text class="uc-name">{{editNameVal || userName}}</text>
        <text class="uc-edit-icon">✏️</text>
      </view>
      <text class="uc-phone">{{userPhone}}</text>
      <view class="uc-tag" wx:if="{{userRole}}">{{userRole}}</view>
    </view>
  </view>

  <!-- 编辑姓名弹窗 -->
  <view class="modal-mask" wx:if="{{showNameEditor}}" bindtap="closeNameEditor"></view>
  <view class="modal name-modal" wx:if="{{showNameEditor}}">
    <view class="modal-hd">
      <text class="modal-title">修改昵称</text>
      <text class="modal-close" bindtap="closeNameEditor">✕</text>
    </view>
    <view class="modal-bd">
      <input class="form-input" placeholder="输入新昵称" value="{{editNameVal}}" bindinput="onNameInput" maxlength="20"/>
    </view>
    <view class="modal-ft">
      <button class="btn-cancel" bindtap="closeNameEditor">取消</button>
      <button class="btn-primary" bindtap="saveName">保存</button>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="changePwd"><text class="mi-icon">🔑</text><text class="mi-txt">修改密码</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goTenants"><text class="mi-icon">👥</text><text class="mi-txt">租客管理</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="showReport"><text class="mi-icon">📊</text><text class="mi-txt">收支报表</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goUtilities"><text class="mi-icon">🔌</text><text class="mi-txt">水电煤</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goRepairs"><text class="mi-icon">🔧</text><text class="mi-txt">维修报修</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goFiling"><text class="mi-icon">📋</text><text class="mi-txt">合同备案</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goCustomers"><text class="mi-icon">👤</text><text class="mi-txt">意向客户</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goSubscription"><text class="mi-icon">💳</text><text class="mi-txt">套餐订阅</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goInvite"><text class="mi-icon">📨</text><text class="mi-txt">邀请协作</text><text class="mi-arrow">›</text></view>
  </view>

  <!-- ===== 邀请协作弹窗 ===== -->
  <view class="modal-mask" wx:if="{{showInvite}}" bindtap="closeInvite"></view>
  <view class="modal" wx:if="{{showInvite}}">
    <view class="modal-hd">
      <text class="modal-title">📨 邀请协作</text>
      <text class="modal-close" bindtap="closeInvite">✕</text>
    </view>
    <view class="modal-bd invite-bd">
      <text class="invite-desc">分享此邀请码给合伙人，对方注册后自动关联</text>
      <view class="invite-code-box" wx:if="{{inviteCode}}">
        <text class="invite-code">{{inviteCode}}</text>
        <button class="btn-copy-sm" bindtap="copyInviteCode">📋 复制</button>
      </view>
      <view class="invite-qr" wx:if="{{inviteCode}}">
        <image src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&data={{qrData}}" mode="widthFix" class="qr-img"/>
        <text class="qr-hint">对方扫码打开小程序 → 输入此邀请码</text>
      </view>
      <button class="btn-gen" wx:if="{{!inviteCode}}" bindtap="genInvite" loading="{{inviteLoading}}">🔄 生成邀请码</button>
      <button class="btn-gen" wx:if="{{inviteCode}}" bindtap="genInvite">🔄 重新生成</button>
    </view>
  </view>

  <button class="logout" bindtap="doLogout">退出登录</button>

  <!-- ===== 修改密码弹窗 ===== -->
</view>
